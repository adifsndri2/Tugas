---
import Base from './base.astro';
import Icon from '../components/icon.astro';
import logo from '../image/dst-transparant2-AVLakLNb0ZHlXE4v.avif';
const { title } = Astro.props;
---

<Base title={`${title} | Admin Katalog DST`}>
    <div class="min-h-screen bg-[#F5F7FA]">
        <header class="sticky top-0 z-40 border-b border-[#E8ECF2] bg-white/95 shadow-[0_3px_14px_rgba(20,43,78,0.08)] backdrop-blur">
            <div class="mx-auto flex min-h-[78px] max-w-[1180px] items-center justify-between gap-4 px-4 py-3 sm:px-8">
                <a href="/admin" class="flex items-center gap-3 text-[#203D79] no-underline">
                    <img src={logo.src} alt="Digital Solusi Terpadu" class="h-10 w-auto max-w-[180px] object-contain" />
                    <span class="hidden h-8 w-px bg-[#DCE3EB] sm:block"></span>
                    <strong class="text-sm sm:text-base">Admin katalog</strong>
                </a>
                <div class="flex items-center gap-3">
                    <a href="/" class="inline-flex h-10 items-center gap-1.5 rounded-md border border-[#D8E0EA] px-3 text-xs font-semibold text-[#203D79] no-underline transition hover:bg-[#F4F7FA] sm:text-sm">
                        <Icon name="arrow" class="size-4 rotate-180" />
                        Lihat portal
                    </a>
                    <form method="POST" action="/admin/logout">
                        <button class="h-10 cursor-pointer whitespace-nowrap rounded-md px-3 text-xs font-semibold text-[#59677A] transition hover:bg-[#F4F7FA] hover:text-[#203D79] sm:text-sm">Keluar</button>
                    </form>
                </div>
            </div>
        </header>
        <main class="mx-auto max-w-[1180px] px-4 py-6 sm:px-8 sm:py-10">
            <slot/>
        </main>
    </div>
</Base>