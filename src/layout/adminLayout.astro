---
import Base from './base.astro';
import Icon from '../components/icon.astro';
import logo from '../image/dst-transparant2-AVLakLNb0ZHlXE4v.avif';
const { title } = Astro.props;
---

<Base title={`${title} | Admin Katalog DST`}>
    <div class="min-h-screen bg-[linear-gradient(135deg,#F0FBFC_0%,#F4F6FF_58%,#F7F2FF_100%)]">
        <header class="border-b border-white/10 bg-[#102A72] shadow-[0_3px_14px_rgba(15,27,45,0.12)]">
            <div class="mx-auto flex min-h-16 max-w-[1120px] items-center justify-between gap-4 px-4 py-3 sm:px-8">
                <a href="/admin" class="flex items-center gap-3 text-white no-underline">
                    <span class="grid h-9 min-w-9 shrink-0 place-items-center rounded-[10px] bg-white px-1.5">
                        <img src={logo.src} alt="Logo DST" class="h-7 w-auto max-w-[108px] object-contain" />
                    </span>
                    <strong class="text-sm sm:text-base">Admin katalog</strong>
                </a>
                <div class="flex items-center gap-3">
                    <a href="/" class="inline-flex h-9 items-center gap-1.5 rounded-full border border-white/30 px-3 text-xs font-semibold text-white no-underline transition hover:bg-white/10 sm:text-sm">
                        <Icon name="arrow" class="size-4 rotate-180" />
                        Lihat portal
                    </a>
                    <form method="POST" action="/admin/logout">
                        <button class="h-9 cursor-pointer whitespace-nowrap rounded-full px-3 text-xs font-semibold text-[#DCE7FF] transition hover:bg-white/10 sm:text-sm">Keluar</button>
                    </form>
                </div>
            </div>
        </header>
        <main class="mx-auto max-w-[1120px] px-4 py-6 sm:px-8 sm:py-10">
            <slot/>
        </main>
    </div>
</Base>