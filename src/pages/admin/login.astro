---
import Base from '../../layout/base.astro';
import { ADMIN_PASSWORD, ADMIN_TOKEN } from '../../lib/auth';

let error = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (ADMIN_PASSWORD && ADMIN_TOKEN && String(f.get('password')) === ADMIN_PASSWORD) {
    Astro.cookies.set('session', ADMIN_TOKEN, {
      httpOnly: true,
      sameSite: 'lax',
      path: '/',
      maxAge: 60 * 60 * 8,
      secure: import.meta.env.PROD, // hapus baris ini bila produksi masih diakses lewat http
    });
    return Astro.redirect('/admin');
  }
  error = 'Password salah';
}
---
<Base title="Masuk | Admin Katalog DST">
  <div class="grid min-h-dvh bg-white md:grid-cols-2">
    <aside class="relative hidden min-h-screen overflow-hidden bg-[radial-gradient(circle_at_80%_15%,rgba(66,103,213,0.5),transparent_35%),linear-gradient(135deg,#102A72,#123B9B)] p-8 text-white md:flex md:flex-col md:justify-between lg:p-12">
      <div class="pointer-events-none absolute inset-0 opacity-30 [background-image:radial-gradient(rgba(255,255,255,0.3)_1px,transparent_1px)] [background-size:24px_24px]"></div>
      <a href="/" class="relative flex items-center gap-3 text-sm font-bold text-white no-underline">
        <span class="grid size-10 place-items-center rounded-xl bg-white text-xs font-bold text-[#123B9B]">DST</span>
        <span>Portal DST Apps</span>
      </a>
      <div class="relative max-w-[430px] pb-10">
        <h1 class="text-[38px] font-bold leading-[1.1] lg:text-[42px]">Kelola katalog<br /><span class="text-[#9EB8FF]">layanan DST</span></h1>
        <p class="mt-5 max-w-[390px] text-sm leading-relaxed text-[#DCE7FF] lg:text-base">
          Tambah, ubah, atau hapus layanan yang tampil di portal, lengkap dengan gambar, deskripsi, dan link.
        </p>
      </div>
      <p class="relative text-xs text-[#DCE7FF]">Khusus pengelola katalog.</p>
    </aside>

    <main class="flex min-h-dvh items-start justify-center overflow-y-auto bg-white px-5 py-8 sm:items-center sm:px-10 sm:py-12 lg:px-16">
      <form method="POST" class="w-full max-w-[365px]">
        <a href="/" class="mb-8 inline-flex text-sm font-semibold text-brand no-underline md:hidden">← Portal DST Apps</a>
        <div class="mb-6 sm:mb-7">
          <h1 class="text-[26px] font-bold text-ink sm:text-[28px]">Masuk Admin</h1>
          <p class="mt-2 text-sm text-muted">Masukkan password untuk mengelola katalog.</p>
        </div>
        <label for="password" class="label">Password</label>
        <div class="relative">
          <input id="password" name="password" type="password" class="field pr-28" aria-invalid={error ? 'true' : undefined} />
          <button type="button" data-toggle-password class="absolute inset-y-0 right-3 text-xs font-semibold text-brand sm:text-sm">Tampilkan</button>
        </div>
        {error && <p class="mt-1.5 text-[13px] text-danger">{error}</p>}
        <button class="btn btn-primary mt-5 h-12 w-full rounded-xl sm:mt-6">Masuk</button>
        <p class="mt-5 text-center text-xs text-muted sm:mt-6 sm:text-sm">
          Hanya ingin melihat layanan? 
          <a href="/" class="font-semibold text-brand no-underline hover:underline"> Buka portal </a>
        </p>
      </form>
    </main>
  </div>
</Base>

<script>
  const toggle = document.querySelector('[data-toggle-password]');
  const password = document.querySelector<HTMLInputElement>('#password');
  toggle?.addEventListener('click', () => {
    if (!password) return;
    const visible = password.type === 'text';
    password.type = visible ? 'password' : 'text';
    toggle.textContent = visible ? 'Tampilkan' : 'Sembunyikan';
  });
</script>