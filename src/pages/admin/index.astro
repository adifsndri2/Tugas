---
import AdminLayout from '../../layout/adminLayout.astro';
import Icon from '../../components/icon.astro';
import { searchCatalogs, countCatalogs, getCatalog, deleteCatalog } from '../../lib/catalog';
import { deleteImage } from '../../lib/upload';

//Hapus (from POST ke halaman Admin)
if (Astro.request.method === 'POST') {
    const id = Number((await Astro.request.formData()).get('id'));
    const row = getCatalog(id);
    if (row){
        await deleteImage(row.image_path);
        deleteCatalog(id);
    }
    return Astro.redirect(Astro.url.pathname + Astro.url.search);
}

const PAGE_SIZE = 5;
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1 );
const total = countCatalogs(q);
const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));
const items = searchCatalogs(q, PAGE_SIZE, (page - 1) * PAGE_SIZE);
const href = (p: number) => `?${new URLSearchParams({...(q ? {q} : {}), page: String(p)})}`;
const rowCls = 'grid grid-cols-1 items-start gap-4 px-4 py-4 sm:px-6 md:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)_auto] md:items-center md:gap-5 md:py-3.5';
---


<AdminLayout title="Daftar Katalog">
    <div class="relative mb-6 overflow-hidden rounded-2xl bg-[radial-gradient(circle_at_92%_20%,rgba(73,132,255,0.65),transparent_28%),linear-gradient(115deg,#102A72,#315CD0)] px-5 py-6 text-white shadow-[0_8px_24px_rgba(24,58,120,0.12)] sm:px-7 sm:py-7">
        <div class="pointer-events-none absolute inset-0 opacity-25 [background-image:radial-gradient(rgba(255,255,255,0.35)_1px,transparent_1px)] [background-size:22px_22px]"></div>
        <div class="relative flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[10px] font-semibold text-[#BEEBFF]">
                <span class="size-1.5 rounded-full bg-[#55E7C5]"></span>
                Panel Pengelola
            </span>
            <h1 class="mt-3 text-[28px] font-bold">Katalog Layanan</h1>
            <p class="mt-1.5 text-sm text-[#DCE7FF]">{total} layanan terdaftar di portal</p>
        </div>
        <a href="/admin/create" class="inline-flex h-10 items-center justify-center gap-2 rounded-full bg-white px-4 text-xs font-semibold text-[#123B9B] no-underline transition hover:bg-[#DCE7FF] sm:text-sm"><Icon name="plus" class="size-[18px]"/> Tambah Katalog </a>
        </div>
    </div>

    <form method="GET" role="search" class="relative mb-4 max-w-[380px]">
        <label for="s" class="sr-only" > Cari Katalog </label>
        <input id="s" name="q" value={q} placeholder="Cari nama atau link" class="field rounded-full bg-white pl-11 shadow-[0_3px_12px_rgba(24,58,120,0.05)]"/>
        <icon name="search" class="absolute top-3.5 left-3.5 size-5 text-muted"/> 
    </form>

    <div class="overflow-hidden rounded-2xl border border-[#E3EAF5] bg-white shadow-[0_6px_20px_rgba(24,58,120,0.07)]">
        <div class="hidden items-center gap-5 bg-[#F3F7FF] px-6 py-3 text-xs font-bold tracking-wide text-[#52658B] md:grid md:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)_auto]">
            <span> Layanan </span> <span> Link</span> <span class="w-[136px]"> Aksi </span>
        </div>
        {items.length === 0 && <p class="border-t border-line p-8 text-center text-muted">Tidak ada katalog</p>}

        {items.map((it) => (
            <div class={`${rowCls} border-t border-line`}>
            <div class="flex min-w-0 items-center gap-4">
                <div class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-xl bg-brand-soft text-brand">
                    {it.image_path ? <img src={it.image_path} alt="" class="size-full object-contain"/> : <Icon name="grid" class="size-6"/>}
                </div>

                <div class="min-w-0">
                    <b class="block text-[15px]"> {it.name} </b>
                    <small class="block truncate text-[13px] text-muted"> {it.description} </small>
                </div>
            </div>


            <a href={it.link} target="blank" rel="noopener noreferrer" class="hidden truncate text-sm text-brand md:block"> {it.link.replace('https://', '').replace('http://', '')} </a>

            <div class="flex w-full justify-end gap-2 md:w-auto">
                <a href={`/admin/edit/${it.id}`} class="btn h-10 px-3 text-xs sm:text-sm"> <icon name="pencil" class="size-4"/> Edit </a>

                <form method="POST" onsubmit="return confirm('Hapus katalog ini?')"> <input type="hidden" name="id" value={it.id} /> <button class="btn btn-danger h-10 px-3" aria-label={`Hapus ${it.name}`}> <Icon name="trash" class="size-[18px]" /></button> </form> 
            </div> 
        </div>
            )) }
    </div>

    <div class="mt-4 flex flex-col gap-3 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <span>Menampilkan {items.length} dari {total} katalog</span>

        <div class="flex w-full gap-2 sm:w-auto">
            {page > 1 ? <a href={href(page - 1)} class="btn h-10 flex-1 px-3 text-xs sm:flex-none sm:text-sm">Sebelumnya</a> : <span class="btn h-10 flex-1 px-3 text-xs opacity-50 sm:flex-none sm:text-sm" aria-disabled="true">Sebelumnya</span>}
            {page < lastPage ? <a href={href(page + 1)} class="btn h-10 flex-1 px-3 text-xs sm:flex-none sm:text-sm">Selanjutnya</a> : <span class="btn h-10 flex-1 px-3 text-xs opacity-50 sm:flex-none sm:text-sm" aria-disabled="true">Selanjutnya</span>}
        </div>
    </div>

</AdminLayout>
