---
import Base from '../layout/base.astro';
import CatalogCard from '../components/CatalogCard.astro';
import icon from '../components/icon.astro';
import { ADMIN_TOKEN } from '../lib/auth';
import { countCatalogs, searchCatalogs } from '../lib/catalog';
import { projectDescription } from '../lib/projectDescription';
import logo from '../image/dst-transparant2-AVLakLNb0ZHlXE4v.avif';

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const items = searchCatalogs(q);
const isAdmin = Boolean(ADMIN_TOKEN && Astro.cookies.get('session')?.value === ADMIN_TOKEN);
const accents = ['blue', 'teal', 'amber', 'green', 'red', 'violet'];
---

<Base title="Portal DST Apps" description={projectDescription}>
    <div class="min-h-screen overflow-hidden bg-[linear-gradient(135deg,#E8FAFC_0%,#F2F4FF_55%,#F5F1FF_100%)] pb-12">
        <section class="relative bg-[radial-gradient(circle_at_86%_52%,rgba(73,132,255,0.8),transparent_18%),linear-gradient(115deg,#102A72_0%,#123B9B_48%,#315CD0_100%)] px-6 pt-[68px] text-white sm:px-8">
            <div class="pointer-events-none absolute inset-0 opacity-30 [background-image:radial-gradient(rgba(255,255,255,0.34)_1px,transparent_1px)] [background-size:24px_24px]"></div>
            <div class="pointer-events-none absolute -left-20 top-28 size-64 rounded-full border border-white/20"></div>
            <div class="pointer-events-none absolute -right-20 top-36 size-64 rounded-full bg-[#4A8BEB]/30"></div>
            <span class="pointer-events-none absolute left-[13%] top-44 size-2 rounded-full bg-[#FFC52F]"></span>
            <span class="pointer-events-none absolute right-[15%] top-20 size-2 rounded-full bg-[#FF6B78]"></span>
            <span class="pointer-events-none absolute left-[24%] bottom-20 size-1.5 rounded-full bg-[#55E7C5]"></span>

            <div class="mx-auto max-w-[1120px]">
                <nav class="fixed inset-x-0 top-0 z-50 flex h-[68px] items-center justify-between border-b border-white/10 bg-[#102A72]/95 px-6 shadow-[0_3px_14px_rgba(15,27,45,0.16)] backdrop-blur sm:px-8">
                    <a href="/" aria-label="Kembali ke halaman utama" class="mx-auto flex w-full max-w-[1120px] items-center gap-2 text-sm font-bold text-white no-underline">
                        <span class="grid h-8 min-w-8 place-items-center rounded-lg bg-white px-1.5">
                            <img src={logo.src} alt="Logo DST" class="h-6 w-auto max-w-[105px] object-contain" />
                        </span>
                        <span>Portal DST Apps</span>
                    </a>
                    <a href={isAdmin ? '/admin' : '/admin/login'} class="absolute right-6 rounded-full bg-white px-4 py-2 text-xs font-semibold text-[#123B9B] no-underline transition hover:bg-[#DCE7FF] sm:right-8">
                        {isAdmin ? 'Kelola Katalog' : 'Masuk Admin'}
                    </a>
                </nav>

                <header class="relative mx-auto max-w-[620px] pb-20 pt-9 text-center">
                    <div class="mx-auto mb-5 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[10px] font-semibold text-[#BEEBFF]">
                        <span class="size-1.5 rounded-full bg-[#55E7C5]"></span>
                        Layanan Internal
                    </div>
                    <h1 class="text-[32px] leading-tight font-bold sm:text-[40px]">
                        Selamat Datang<br><span class="text-[#DCE7FF]">di Portal DST Apps</span>
                    </h1>
                    <p class="mx-auto mt-4 max-w-[500px] text-xs leading-relaxed text-[#DCE7FF] sm:text-sm">
                        {projectDescription}
                    </p>
                    <form method="GET" role="search" class="relative mx-auto mt-6 max-w-[360px]">
                        <label for="q" class="sr-only">Cari Layanan</label>
                        <input id="q" name="q" value={q} placeholder="Cari layanan..." class="h-10 w-full rounded-full border-0 bg-white pr-20 pl-10 text-xs text-ink shadow-lg outline-none ring-brand focus:ring-2"/>
                        <icon name="search" class="absolute top-2.5 left-3.5 size-4 text-brand"/>
                        <span class="absolute top-3 right-4 text-[9px] text-muted">{countCatalogs(q)} layanan</span>
                    </form>
                </header>
            </div>
        </section>

        <main class="relative z-10 mx-auto -mt-12 max-w-[940px] px-6 sm:px-8">
            <section class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
                {items.length === 0 ? (
                    <p class="col-span-full text-center text-muted">
                        {q ? `Tidak ada Layanan yang ditemukan untuk "${q}"` : `Tidak ada Layanan yang tersedia`}
                    </p>
                ) : (
                    items.map((it, index) => <CatalogCard item={it} accent={accents[index % accents.length]}/>)
                )}
            </section>
            <p class="mt-7 text-center text-[10px] text-muted">Beberapa layanan hanya dapat diakses dari jaringan atau IP tertentu.</p>
        </main>
    </div>
</Base>
